/* ──────────────────────────────────────────────
   Survival Inventory  ·  야전 보급 상자 느낌
   바탕: 국방색 캔버스 / 글자: 바랜 뼈색
   칸 배경은 등급 그림(Resources/SurvivalInventory/Rarity)이 맡는다.
   ────────────────────────────────────────────── */

.inv-root {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(10, 11, 8, 0.6);
}

.inv-root Label {
    margin: 0;
    padding: 0;
}

.panel {
    width: 880px;
    padding: 18px 20px 16px 20px;
    background-color: rgb(38, 40, 31);
    border-width: 1px;
    border-color: rgb(63, 66, 52);
    border-radius: 6px;
    color: rgb(230, 223, 201);
}

/* ── 머리줄 ── */
.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(230, 223, 201);
}

.header-meta {
    margin-left: 12px;
    font-size: 13px;
    color: rgb(156, 152, 131);
}

.spacer { flex-grow: 1; }
.flex-spacer { flex-grow: 1; }

/* ── 버튼 (기본 테마 덮어쓰기 위해 Button.btn 사용) ── */
Button.btn {
    margin: 0 0 0 6px;
    padding: 6px 12px;
    min-height: 30px;
    background-color: rgb(48, 51, 40);
    border-width: 1px;
    border-color: rgb(72, 76, 60);
    border-radius: 4px;
    color: rgb(220, 213, 192);
    font-size: 13px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

Button.btn:hover {
    background-color: rgb(60, 63, 50);
    border-color: rgb(110, 112, 92);
}

Button.btn:active {
    background-color: rgb(34, 36, 28);
}

Button.btn:focus {
    border-color: rgb(150, 146, 120);
}

Button.btn--primary {
    background-color: rgb(222, 213, 186);
    border-color: rgb(222, 213, 186);
    color: rgb(30, 31, 24);
    -unity-font-style: bold;
}

Button.btn--primary:hover {
    background-color: rgb(240, 233, 210);
    border-color: rgb(240, 233, 210);
}

Button.btn--primary:active {
    background-color: rgb(196, 188, 162);
}

Button.btn--danger:hover {
    border-color: rgb(201, 79, 69);
    color: rgb(236, 140, 130);
}

/* ── 분류 탭 ── */
.tabs {
    flex-direction: row;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-color: rgb(58, 61, 48);
}

Button.tab {
    margin: 0 2px -1px 0;
    padding: 7px 14px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
    color: rgb(156, 152, 131);
    font-size: 13px;
    transition-property: color, border-color;
    transition-duration: 0.12s;
}

Button.tab:hover {
    color: rgb(220, 213, 192);
    background-color: rgba(255, 255, 255, 0.03);
}

Button.tab--active {
    color: rgb(230, 223, 201);
    border-bottom-color: rgb(230, 223, 201);
    -unity-font-style: bold;
}

/* ── 본문 ── */
.body {
    flex-direction: row;
    align-items: flex-start;
}

.grid {
    width: 468px;           /* (72 + 3*2) × 6열 */
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
}

/* ── 칸 ── */
.slot {
    width: 72px;
    height: 72px;
    margin: 3px;
    background-color: rgb(30, 32, 25);
    border-width: 1px;
    border-color: rgb(54, 57, 45);
    border-radius: 4px;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
    transition-property: background-color, border-color, opacity;
    transition-duration: 0.1s;
}

.slot:hover {
    border-color: rgb(120, 118, 98);
    background-color: rgb(38, 40, 32);
}

.slot--empty {
    background-color: rgb(27, 29, 23);
    border-color: rgb(46, 49, 38);
}

.slot.slot--selected {
    border-color: rgb(230, 223, 201);
    background-color: rgb(50, 52, 41);
}

.slot.slot--drop-target {
    border-color: rgb(230, 223, 201);
    background-color: rgb(56, 58, 46);
}

.slot--drag-source { opacity: 0.35; }
.slot--dimmed { opacity: 0.25; }

.slot__icon {
    position: absolute;
    left: 10px; top: 12px; right: 10px; bottom: 10px;
    align-items: center;
    justify-content: center;
    -unity-background-scale-mode: scale-to-fit;
}

/* 아이콘 그림이 있으면 칸을 꽉 채운다 */
.slot--has-icon .slot__icon {
    left: 0; top: 0; right: 0; bottom: 0;
}

.slot__abbr {
    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(214, 206, 182);
}

.slot__count {
    position: absolute;
    right: 6px;
    bottom: 4px;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(240, 233, 210);
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.9);
}

/* ── 상세 정보 ── */
.detail {
    flex-grow: 1;
    min-height: 312px;
    align-self: stretch;
    margin-left: 18px;
    margin-top: 3px;
    padding: 16px;
    background-color: rgb(32, 34, 26);
    border-width: 1px;
    border-color: rgb(54, 57, 45);
    border-radius: 4px;
}

.detail-empty {
    flex-grow: 1;
    -unity-text-align: middle-center;
    white-space: normal;
    font-size: 13px;
    color: rgb(126, 123, 106);
}

.detail-content { flex-grow: 1; }

.detail-head {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.detail-icon {
    width: 72px;
    height: 72px;
    margin-right: 14px;
    align-items: center;
    justify-content: center;
    background-color: rgb(27, 29, 23);
    border-width: 1px;
    border-color: rgb(20, 20, 16);
    border-radius: 4px;
    overflow: hidden;
    -unity-background-scale-mode: scale-to-fit;
}

.art {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.detail-abbr {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(214, 206, 182);
}

.detail-title { flex-shrink: 1; }

.detail-name {
    font-size: 19px;
    -unity-font-style: bold;
    white-space: normal;
}

.chips {
    flex-direction: row;
    margin-top: 6px;
}

.chip {
    margin-right: 5px;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(28, 26, 20);
}

.chip--muted {
    background-color: rgb(58, 61, 48);
    color: rgb(214, 206, 182);
}

.detail-desc {
    min-height: 44px;
    margin-bottom: 12px;
    white-space: normal;
    font-size: 13px;
    color: rgb(184, 178, 156);
}

.stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 7px 0;
    border-top-width: 1px;
    border-color: rgb(50, 53, 42);
}

.stat-key {
    font-size: 12px;
    color: rgb(140, 136, 116);
}

.stat-val {
    font-size: 13px;
    color: rgb(222, 215, 194);
}

.detail-actions {
    flex-direction: row;
    padding-top: 14px;
}

.detail-actions Button.btn {
    flex-grow: 1;
    margin: 0 6px 0 0;
}

/* ── 아래줄: 무게 ── */
.footer {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 14px;
}

.weight {
    width: 462px;
    margin-left: 3px;
}

.weight-head {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 6px;
}

.weight-track {
    height: 6px;
    background-color: rgb(27, 29, 23);
    border-radius: 3px;
    overflow: hidden;
}

.weight-fill {
    height: 100%;
    width: 0;
    background-color: rgb(134, 158, 92);
    border-radius: 3px;
    transition-property: width, background-color;
    transition-duration: 0.25s;
}

.weight--warn .weight-fill { background-color: rgb(217, 164, 58); }
.weight--full .weight-fill { background-color: rgb(201, 79, 69); }
.weight--full .stat-val { color: rgb(236, 140, 130); }

.hint {
    flex-grow: 1;
    margin-left: 24px;
    -unity-text-align: lower-right;
    font-size: 11px;
    color: rgb(118, 115, 98);
}

/* ── 알림 ── */
.toast {
    position: absolute;
    bottom: 9%;
    padding: 8px 16px;
    background-color: rgb(30, 32, 25);
    border-width: 1px;
    border-color: rgb(96, 96, 78);
    border-radius: 4px;
    font-size: 13px;
    color: rgb(230, 223, 201);
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.2s;
}

.toast--show { opacity: 1; }

/* ── 끌고 다니는 아이템 ── */
.drag-ghost {
    display: none;
    position: absolute;
    width: 64px;
    height: 64px;
    align-items: center;
    justify-content: center;
    background-color: rgba(50, 52, 41, 0.92);
    border-width: 1px;
    border-color: rgb(230, 223, 201);
    overflow: hidden;
    border-radius: 4px;
    -unity-background-scale-mode: scale-to-fit;
}
